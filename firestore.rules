rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'charanbhogavalli04116@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Garages collection
    match /garages/{garageId} {
      allow read, write: if true;
    }

    // Suppliers collection (public B2B catalog directory)
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Products collection (public automotive spare parts catalogue)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Demand Pools collection (public aggregation pools)
    match /pools/{poolId} {
      allow read, write: if true;
    }

    // Commitments collection
    match /commitments/{commitmentId} {
      allow read: if true;
      allow create, update: if request.resource.data.quantity is int && request.resource.data.quantity > 0;
      allow delete: if true;
    }

    // Purchase Orders collection
    match /purchaseOrders/{orderId} {
      allow read, write: if true;
    }

    // Connection test collection
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}
